# OpenAI API Key (required for OpenAI embeddings & LLM)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Pinecone API Key (free tier)
# Get yours at: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key

# Pinecone Index Name
PINECONE_INDEX_NAME=agentic-ai-index

# Embedding Provider: "openai" or "huggingface"
# If OPENAI_API_KEY is not set, defaults to "huggingface"
EMBEDDING_PROVIDER=openai

# LLM Provider: "openai" or "ollama"
# If OPENAI_API_KEY is not set, defaults to "ollama"
LLM_PROVIDER=openai
