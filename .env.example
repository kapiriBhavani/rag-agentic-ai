# OpenAI API Key (optional - for OpenAI embeddings & LLM)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Google Gemini API Key (optional - free tier available)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key

# Pinecone API Key (free tier)
# Get yours at: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key

# Pinecone Index Name
PINECONE_INDEX_NAME=agentic-ai-index

# Embedding Provider: "openai", "google", or "huggingface"
# Auto-detected if not set (OpenAI > Google > HuggingFace)
EMBEDDING_PROVIDER=openai

# LLM Provider: "openai", "google", or "ollama"
# Auto-detected if not set (OpenAI > Google > Ollama)
LLM_PROVIDER=openai
